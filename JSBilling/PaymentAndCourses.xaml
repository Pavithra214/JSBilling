<Window x:Class="JSBilling.PaymentAndCourses"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JSBilling"
        mc:Ignorable="d"
        Title="PaymentAndCourses" Height="1000" Width="800">
    <Grid>
        <!--Header-->
        <TextBlock Text="JSquare Training Portal" Foreground="Black" FontSize="24" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,30,0,0"></TextBlock>

        <Border Width="600" Height="630" Background="WhiteSmoke" CornerRadius="18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="-90" Color="#000"></DropShadowEffect>
            </Border.Effect>
            <TabControl>
                <TabItem Header="Student details"  Height="40" Width="300" HorizontalAlignment="Center">
                   
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20">
                        <TabControl>
                            <TabItem Header="Course Details">
                                <StackPanel>
                                    <TextBlock Text="Courses" Margin="0,10,0,0"></TextBlock>
                                    <ComboBox x:Name="cmbcourse" SelectionChanged="cmbcourse_SelectionChanged" Margin="0,15,0,15" Width="300" Height="35" Grid.Row="1">
                                       
                                    </ComboBox>
                                    <TextBlock Text="Batches"></TextBlock>
                                    <ComboBox x:Name="cmbbatches" SelectionChanged="cmbbatches_SelectionChanged">
                                        <ComboBoxItem Content="Batch1"></ComboBoxItem>
                                        <ComboBoxItem Content="Batch2"></ComboBoxItem>
                                    </ComboBox>
                                    <TextBox x:Name="txttime" Margin="0,10,0,0" Height="30"></TextBox>
                                </StackPanel> 
                            </TabItem>
                            <TabItem Header="Payment Details">
                                <StackPanel Margin="0,15,0,0">
                                    <TextBlock Text="Student Name"></TextBlock>
                                <ComboBox x:Name="cmbstudName">
                                   
                                </ComboBox>
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                            </Grid.RowDefinitions>
                           
                           
                           
                        </Grid>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Staff Details"   Height="40" Width="250" HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                               

                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Role"></TextBlock>
                            <ComboBox x:Name="cmbstaffrole" Margin="0,15,0,15" Width="300" Height="35" Grid.Row="1">
                                <ComboBoxItem Content="HR"></ComboBoxItem>
                                <ComboBoxItem Content="Trainer"></ComboBoxItem>
                                <ComboBoxItem Content="Admin"></ComboBoxItem>
                            </ComboBox>
                           
                        </Grid>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Window>
