<Window x:Class="JSBilling.AdminDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JSBilling"
        mc:Ignorable="d"
        Title="AdminDashboard" Height="800" Width="1000">
    <Grid Margin="20">
        <!--Header-->
        <Border Background="Tomato" Height="80" VerticalAlignment="Top" CornerRadius="10">
            <TextBlock Text="Admin Dashboard - Manage Students" Foreground="White" FontWeight="Bold" FontSize="25" HorizontalAlignment="Center"></TextBlock>
        </Border>
        
        <!--Main Content-->
        <Grid Margin="0,100,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                
            </Grid.RowDefinitions>
            
            <!--Search and Add Student-->

            <StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Stretch">
                <Grid Width="300" Height="40" Margin="0,0,10,0">
                    <TextBox BorderBrush="White" VerticalContentAlignment="Center" Padding="5,0,0,0"></TextBox>
               
                </Grid>
                
                <Button Content="Search" Width="100" Background="Tomato" Foreground="White" FontWeight="Black" Margin="0,0,10,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"></Setter>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="Add New Student" Width="150" Background="Tomato" Foreground="White" FontWeight="Black">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"></Setter>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>

            <!--GridView to display student data-->
            <Border Background="White" Grid.Row="1" CornerRadius="10" Padding="10" Margin="0,10,0,0">
            <ListView x:Name="lststudent" Margin="10" IsSynchronizedWithCurrentItem="True">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Id" Width="50" DisplayMemberBinding="{Binding id}"/>
                            <GridViewColumn Header="Name" Width="100" DisplayMemberBinding="{Binding fullname}"/>
                            <GridViewColumn Header="PhoneNo" Width="100" DisplayMemberBinding="{Binding Phoneno}"/>
                            <GridViewColumn Header="CheckInStatus" Width="100" DisplayMemberBinding="{Binding CheckIn}"/>
                            <GridViewColumn Header="NotesStatus" Width="100" DisplayMemberBinding="{Binding Notes}"/>
                            <GridViewColumn Header="DemoStatus" Width="100" DisplayMemberBinding="{Binding Demo}"/>
                            <GridViewColumn Header="ProjectStatus" Width="100" DisplayMemberBinding="{Binding Project}"/>
                            <GridViewColumn Header="Actions" Width="200">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="Edit" Width="60" Margin="0,0,10,0" Background="Yellow"></Button>
                                            <Button Content="Delete" Width="60" Background="YellowGreen"></Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                           
                        </GridView>
                </ListView.View>
            </ListView>
            </Border>
        </Grid>
    </Grid>
</Window>
