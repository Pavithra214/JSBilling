<Window x:Class="JSBilling.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JSBilling"
        mc:Ignorable="d"
        Title="JSquare Registration and Login" Height="750" Width="800" WindowStartupLocation="CenterScreen" WindowStyle="None">
    <Window.Background>
        <ImageBrush ImageSource="C:\Users\PAVITHRA\Downloads\Red.jpg" ></ImageBrush>
    </Window.Background>
    <Grid>
        <!--Header-->
        <TextBlock Text="JSquare Training Portal" Foreground="Black" FontSize="24" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,30,0,0"></TextBlock>

        <Border Width="600" Height="630" Background="WhiteSmoke" CornerRadius="18" Margin="0,25,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="-90" Color="#000"></DropShadowEffect>
            </Border.Effect>
            <TabControl>
                <TabItem Header="Login"  Height="40" Width="300" HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Role" Foreground="Red"></TextBlock>
                        <ComboBox x:Name="cmblogin"  Margin="0,15,0,15" Width="300" Height="35" Grid.Row="1">
                            <ComboBoxItem Content="Staff"></ComboBoxItem>
                            <ComboBoxItem Content="Student"></ComboBoxItem>
                        </ComboBox>
                        <TextBlock Text="Email" Grid.Row="2" Margin="0,15"></TextBlock>
                            <TextBox x:Name="txtloginemail" Grid.Row="3" Width="300" Padding="0,5" Foreground="Gray" BorderThickness="0,0,0,1" ></TextBox>
                            <TextBlock Text="Password" Grid.Row="4" Margin="0,15"></TextBlock>
                            <PasswordBox x:Name="pbloginpwd" Grid.Row="5" Width="300" Padding="0,5" Foreground="Gray" BorderThickness="0,0,0,1" ></PasswordBox>

                            <TextBlock Text="Confirm Password" Grid.Row="6" Margin="0,15"></TextBlock>
                            <PasswordBox Grid.Row="7" Width="300" Padding="0,5" Foreground="Gray" BorderThickness="0,0,0,1" ></PasswordBox>
                            <Button Grid.Row="8" Content="Login" x:Name="btnlogin" Click="btnlogin_Click" Background="LightPink" Width="150" FontSize="15" FontWeight="DemiBold" Height="50" Margin="0,20,0,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        
                                        <Setter Property="CornerRadius" Value="20"></Setter>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <TextBlock Grid.Row="9" FontSize="15" Text="Dont have an account?Click the Register tab" Foreground="Red" HorizontalAlignment="Center" Margin="20"></TextBlock>
                        </Grid>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Register"   Height="40" Width="250" HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                             
                            </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Role"></TextBlock>
                        <ComboBox x:Name="cmbregister" Margin="0,15,0,15" Width="300" Height="35" Grid.Row="1">
                            <ComboBoxItem Content="Staff"></ComboBoxItem>
                            <ComboBoxItem Content="Student"></ComboBoxItem>
                        </ComboBox>
                            <TextBlock Text="Full Name" Grid.Row="2" Margin="0,15"></TextBlock>
                            <TextBox x:Name="txtregname" Grid.Row="3" Width="300" Padding="0,5" Foreground="Gray" BorderThickness="0,0,0,1" ></TextBox>
                            <TextBlock Text="Phone no" Grid.Row="4" Margin="0,15"></TextBlock>
                            <TextBox x:Name="txtphone" Grid.Row="5" Width="300" Padding="0,5" Foreground="Gray" BorderThickness="0,0,0,1" ></TextBox>
                            <TextBlock Text="Email" Grid.Row="6" Margin="0,15"></TextBlock>
                        <TextBox x:Name="txtregemail" Grid.Row="7" Width="300" Padding="0,5" Foreground="Gray" BorderThickness="0,0,0,1" ></TextBox>
                        <TextBlock Text="Password" Grid.Row="8" Margin="0,15"></TextBlock>
                        <PasswordBox x:Name="pbregpwd" Grid.Row="9" Width="300" Padding="0,5" Foreground="Gray" BorderThickness="0,0,0,1" ></PasswordBox>

                        <TextBlock Text="Confirm Password" Grid.Row="10" Margin="0,15"></TextBlock>
                        <PasswordBox Grid.Row="11" Width="300" Padding="0,5" Foreground="Gray" BorderThickness="0,0,0,1" ></PasswordBox>
                            <Button Grid.Row="12" Background="LightPink" Content="Register" x:Name="btnregister" Click="btnregister_Click" Width="150" FontSize="15" FontWeight="DemiBold" Height="50" Margin="0,20,0,0">
                            <Button.Resources>
                                <Style TargetType="Border">

                                    <Setter Property="CornerRadius" Value="20"></Setter>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </StackPanel>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Window>
